generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Conta bancária no Inter. São TRÊS para quatro lojas: QI e QNE são matriz e
/// filial e compartilham a conta; NRT e SDS têm a sua.
///
/// Credenciais e certificado NÃO ficam aqui — ficam no ambiente, nomeados pelo
/// código da conta (INTER_MATRIZ_CLIENT_ID, INTER_NRT_CERT, …). Chave privada em
/// banco é chave privada em backup, em dump e em tela de administração.
model ContaInter {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  codigo   String  @unique
  nome     String
  cnpj     String
  chavePix String?
  ativo    Boolean @default(true)

  @@map("contas_inter")
}

/// Loja da rede. O código (QI, QNE, NRT, SDS) é a chave usada em toda parte, e
/// não um ObjectId: `"loja": "QI"` num documento é legível quando você precisa
/// entender o que aconteceu, e o conjunto é pequeno e estável.
model Loja {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  codigo String @unique
  nome   String
  /// Razão social, que é o que vai no boleto — diferente do nome curto da tela.
  /// QNE tem a mesma da matriz (é filial); NRT e SDS são outras empresas.
  razaoSocial String?
  cnpj   String @unique
  /// Código da ContaInter que emite boleto e Pix desta loja.
  conta  String
  /// Ordem de exibição. Existe porque alfabética põe NRT antes de QI, e quem lê a
  /// tabela pensa na rede como matriz, filial e depois as outras.
  ordem  Int    @default(0)
  /// Caminho do logo impresso no cupom, servido de /public. É POR LOJA porque a
  /// rede tem três empresas: logo da BrasSaco num cupom da Sacobras seria errado.
  logo   String?

  endereco String?
  bairro   String?
  cidade   String?
  uf       String?
  cep      String?
  telefone String?

  ativo Boolean @default(true)

  @@map("lojas")
}

model Produto {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  codigo    String
  descricao String
  unidade   String
  preco     Float
  /// Produto não é apagado: sai das buscas e do caixa, e o histórico das vendas
  /// que o incluem continua íntegro. Apagar deixaria itens órfãos no relatório.
  ativo     Boolean @default(true)

  @@map("produtos")
}

/// Operador do caixa. A senha nunca é guardada: só o hash scrypt com sal.
model Usuario {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  email         String    @unique
  senhaHash     String
  /// "operador" | "gerente" — a lista canônica e o que cada um alcança estão em
  /// app/lib/permissoes.ts. O padrão é o menor privilégio: quem for cadastrado
  /// sem papel explícito não ganha poder de cancelar venda nem criar usuário.
  papel         String    @default("operador")
  /// Códigos das lojas onde pode operar. VAZIO significa a rede toda — é assim
  /// que o dono entra em qualquer loja sem ser cadastrado quatro vezes.
  /// Quem tem mais de uma escolhe a loja ao entrar.
  lojas         String[]
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now())
  ultimoAcessoEm DateTime?

  @@map("usuarios")
}

/// Cobrança emitida no Inter para uma venda a prazo ("bolepix": boleto com Pix).
/// A emissão é assíncrona, então a linha digitável e o copia-e-cola chegam depois
/// da criação — por isso ficam opcionais e a situação é acompanhada aqui.
model Cobranca {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  vendaId           String   @db.ObjectId
  vendaNumero       Int
  /// Loja que vendeu e conta do Inter que emitiu. A conta fica gravada porque
  /// consultar, baixar o PDF ou cancelar depois exige as MESMAS credenciais —
  /// pedir na conta errada devolve 404 sobre uma cobrança que existe.
  loja              String
  conta             String
  /// Parcelamento: a condição 3× gera três boletos para a mesma venda, com
  /// vencimentos diferentes. Por isso `vendaId` não é mais único — a unicidade
  /// passou a ser o par (vendaId, parcela).
  parcela           Int      @default(1)
  parcelas          Int      @default(1)
  codigoSolicitacao String   @unique
  situacao          String
  valor             Float
  vencimento        DateTime
  linhaDigitavel    String?
  codigoBarras      String?
  nossoNumero       String?
  txid              String?
  pixCopiaECola     String?
  criadaEm          DateTime @default(now())
  atualizadaEm      DateTime @updatedAt

  @@unique([vendaId, parcela])
  @@index([vendaNumero])
  @@index([loja])
  @@map("cobrancas")
}

/// Livro-caixa do estoque: o saldo de um produto é a soma de `quantidade` dos
/// seus movimentos, nunca um número guardado. Saída é negativa, entrada é
/// positiva — assim o estorno é só um movimento de sinal oposto, e o histórico
/// nunca é reescrito.
model MovimentoEstoque {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  produtoId  String   @db.ObjectId
  /// Estoque é físico: existe numa loja. Sem este campo o saldo de quatro lojas
  /// somaria num número que não corresponde a prateleira nenhuma.
  loja       String
  criadoEm   DateTime @default(now())
  /// "venda" | "entrada" | "ajuste" | "estorno"
  /// | "transferencia_saida" | "transferencia_entrada"
  tipo       String
  quantidade Float
  operador   String
  vendaId    String?  @db.ObjectId
  vendaNumero Int?
  /// A transferência que gerou este movimento, quando foi uma.
  ///
  /// Campo, e não só o número na observação: é o que permite ir do extrato de
  /// estoque ("saíram 10 daqui") até o documento que explica o que aconteceu com
  /// eles. Texto numa observação se lê, mas não se navega nem se agrupa.
  transferenciaId     String? @db.ObjectId
  transferenciaNumero Int?
  /// O pedido de compra que gerou este movimento, quando foi um recebimento.
  /// Mesma razão do campo de transferência: navegar até o documento, não só ler
  /// um número solto na observação.
  pedidoDeCompraId     String? @db.ObjectId
  pedidoDeCompraNumero Int?
  observacao String?

  @@index([produtoId, loja])
  @@index([transferenciaId])
  @@index([pedidoDeCompraId])
  @@index([loja, criadoEm])
  @@index([vendaId])
  @@map("movimentos_estoque")
}

/// Os nomes dos campos espelham o objeto `pagador` da API de Cobrança do Inter
/// (endereco, bairro, cidade, uf, cep, ddd, telefone, tipoPessoa) para o boleto
/// ser montado sem camada de tradução. Boleto exige nome, CPF/CNPJ e endereço.
model Cliente {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  cpfCnpj     String   @unique
  /// "FISICA" | "JURIDICA" — derivado do tamanho do documento
  tipoPessoa  String
  endereco    String
  bairro      String
  cidade      String
  uf          String
  cep         String
  numero      String?
  complemento String?
  email       String?
  ddd         String?
  telefone    String?
  /// Mesma ideia do produto: sai das listas sem sumir do histórico. Uma venda
  /// guarda nome e documento copiados, então desativar não reescreve o passado.
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  @@index([nome])
  @@map("clientes")
}

model Venda {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  /// Sequência POR LOJA: cada loja tem a sua numeração, como o comércio espera.
  /// Antes era única global, o que faria QI e NRT disputarem o mesmo número.
  numero   Int
  loja     String
  criadaEm DateTime   @default(now())
  caixa    String
  operador String
  itens    VendaItem[]

  /// Cliente é obrigatório na venda a prazo (o boleto precisa do pagador).
  /// Nome e documento ficam copiados para o histórico não mudar se o cadastro mudar.
  clienteId      String?   @db.ObjectId
  clienteNome    String?
  clienteCpfCnpj String?
  /// Vencimento da venda a prazo. Com parcelamento, é o da primeira parcela.
  vencimento     DateTime?
  /// Id da condição escolhida em CONDICOES_PAGAMENTO (app/lib/pdv.ts).
  condicao       String?
  /// Pix imediato: a venda só nasce depois de o pagamento ser confirmado, então
  /// o txid e o horário ficam guardados como comprovante.
  ///
  /// NÃO usar @unique aqui: o índice único do Mongo não é esparso, campo ausente
  /// conta como null, e só um documento pode ter null — o que barraria toda venda
  /// que não é Pix. A unicidade vem do txid ser aleatório de 35 caracteres.
  pixTxid        String?
  pixPagoEm      DateTime?
  subtotal Float
  desconto Float      @default(0)
  total    Float
  /// Um dos ids de FORMAS_PAGAMENTO em app/lib/pdv.ts — a lista canônica vive lá
  /// para não haver duas fontes da verdade a manter em sincronia.
  forma    String
  recebido Float?
  troco    Float?
  /// Venda cancelada não é apagada: fica com a marca e os movimentos estornados.
  canceladaEm  DateTime?
  canceladaPor String?

  @@unique([loja, numero])
  @@index([loja, criadaEm])
  @@index([pixTxid])
  @@map("vendas")
}

/// Itens ficam embutidos na venda: são imutáveis depois do fechamento e nunca
/// consultados fora dela. Preço e descrição são copiados para o histórico não
/// mudar quando o cadastro do produto mudar.
type VendaItem {
  produtoId  String @db.ObjectId
  codigo     String
  descricao  String
  unidade    String
  preco      Float
  quantidade Float
  subtotal   Float
}

/// Sequência do número de venda, uma por loja: `nome` é "venda:QI". O incremento
/// é atômico ($inc num único documento), então dois caixas simultâneos da mesma
/// loja não pegam o mesmo número.
model Contador {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  nome  String @unique
  valor Int

  @@map("contadores")
}

/// Pedido de autorização do gerente para uma venda que a regra não deixa passar
/// sozinha: cliente inadimplente ou desconto acima do teto.
///
/// Guarda o CARRINHO, e não só a decisão, porque o vendedor larga a venda e
/// atende outro cliente enquanto espera — sem o carrinho gravado ele teria de
/// bipar tudo de novo quando a resposta chegasse, e ninguém faria isso duas
/// vezes: passaria a vender sem pedir.
///
/// O retrato dos preços é para o gerente decidir vendo o que decidiu; a venda em
/// si é recalculada do catálogo na hora de gravar, como toda venda deste sistema.
model Autorizacao {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  loja     String
  caixa    String
  criadaEm DateTime @default(now())

  /// Quem pediu. O id serve para a fila do próprio vendedor; o nome, para o
  /// gerente saber com quem está falando sem uma segunda consulta.
  solicitanteId String @db.ObjectId
  solicitante   String

  /// Ids de MOTIVOS_DE_AUTORIZACAO (app/lib/autorizacao.ts). É lista porque uma
  /// venda pode bater nos dois: cliente devendo E desconto acima do teto.
  motivos String[]

  itens    AutorizacaoItem[]
  subtotal Float
  desconto Float
  total    Float
  /// O desconto em % do subtotal — é o que o gerente lê e o que a guarda compara
  /// na hora de gravar. Guardado, e não recalculado, para a decisão não mudar de
  /// significado se o arredondamento mudar.
  descontoPercentual Float

  clienteId      String? @db.ObjectId
  clienteNome    String?
  clienteCpfCnpj String?

  /// Retrato da dívida no instante do pedido. Fica gravado porque é a informação
  /// com que o gerente decidiu: se ele autorizou vendo R$ 800 vencidos, o
  /// histórico tem de dizer R$ 800 mesmo que o cliente pague amanhã.
  dividaValor      Float @default(0)
  dividaParcelas   Int   @default(0)
  dividaDiasAtraso Int   @default(0)

  /// "pendente" | "aprovada" | "negada" | "usada" | "cancelada"
  situacao      String    @default("pendente")
  decididaEm    DateTime?
  decididaPor   String?
  decididaPorId String?   @db.ObjectId
  /// Como o gerente decidiu: no app, de onde estiver, ou com a senha no próprio
  /// caixa. Sem isto, "quem libera tudo pelo celular sem olhar" fica invisível.
  decididaOnde  String?
  /// Justificativa da negativa, ou a condição que o gerente combinou ao aprovar.
  observacao    String?

  /// A venda que nasceu daqui, quando a autorização foi usada.
  vendaId     String? @db.ObjectId
  vendaNumero Int?

  @@index([situacao, criadaEm])
  @@index([solicitanteId, situacao])
  @@index([loja, situacao])
  @@map("autorizacoes")
}

/// Espelha `VendaItem`: o carrinho guardado do jeito que estava na tela.
type AutorizacaoItem {
  produtoId  String @db.ObjectId
  codigo     String
  descricao  String
  unidade    String
  preco      Float
  quantidade Float
  subtotal   Float
}

/// Uma contagem de gaveta que foi desfeita por uma reabertura.
type ContagemDesfeita {
  fechadoEm   DateTime
  fechadoPor  String
  esperado    Float
  contado     Float
  diferenca   Float
  observacao  String?
  reabertoEm  DateTime
  reabertoPor String
}

/// Remessa de mercadoria de uma loja para outra.
///
/// É um DOCUMENTO, e não um par de movimentos soltos, porque entre a saída e a
/// chegada existe um intervalo em que a mercadoria não está em prateleira
/// nenhuma — está no carro. Sem o documento não há como listar o que está no
/// caminho, nem cobrar a conferência de alguém, nem descobrir onde sumiu o que
/// não chegou.
///
/// O saldo continua derivado do livro de movimentos: a expedição grava uma saída
/// na origem, a conferência grava uma entrada no destino. Este documento não
/// guarda saldo — guarda a INTENÇÃO (o que foi mandado) contra a REALIDADE (o
/// que chegou), que é justamente a diferença que ninguém consegue investigar
/// depois quando só existem os dois movimentos.
model Transferencia {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Sequência única da rede: uma transferência tem dois donos, e numerar por
  /// loja faria a mesma remessa ter números diferentes na origem e no destino.
  numero   Int      @unique
  origem   String
  destino  String
  criadaEm DateTime @default(now())

  enviadaPorId String @db.ObjectId
  enviadaPor   String
  observacao   String?

  itens TransferenciaItem[]

  /// "em_transito" | "recebida" | "recebida_com_falta" | "cancelada"
  ///
  /// `recebida_com_falta` é um estado de verdade, e não um detalhe da recebida:
  /// é o que mantém a diferença visível até um gerente decidir de quem é a
  /// perda. Some da tela cedo demais e a mercadoria sumida vira rotina.
  situacao String @default("em_transito")

  recebidaEm    DateTime?
  recebidaPor   String?
  recebidaPorId String?   @db.ObjectId

  canceladaEm  DateTime?
  canceladaPor String?

  /// Como a falta foi resolvida, quando houve. Preenchido só pelo gerente.
  faltaResolvidaEm  DateTime?
  faltaResolvidaPor String?
  faltaObservacao   String?

  @@index([situacao, criadaEm])
  @@index([origem, situacao])
  @@index([destino, situacao])
  @@map("transferencias")
}

/// O que foi mandado e o que foi contado na chegada, lado a lado.
///
/// `recebida` fica nulo enquanto a carga está no caminho — nulo é "ainda não
/// conferido", que é diferente de zero ("conferido e não veio nada"). A
/// distinção importa: uma é ignorância, a outra é um fato.
type TransferenciaItem {
  produtoId String @db.ObjectId
  codigo    String
  descricao String
  unidade   String
  enviada   Float
  recebida  Float?
}

/// Dinheiro que entra ou sai da gaveta sem ser venda: o troco do início do dia,
/// a sangria para o banco, o reforço de troco no meio da tarde.
///
/// Sem estes lançamentos o fechamento não fecha. O esperado em espécie seria só
/// a soma das vendas em dinheiro, e qualquer loja que comece o dia com troco
/// acusaria diferença TODO dia — e um alarme que dispara sempre é um alarme que
/// as pessoas aprendem a ignorar, junto com os dias em que ele estava certo.
model MovimentoCaixa {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  loja     String
  /// O dia do caixa em "YYYY-MM-DD", no fuso local.
  ///
  /// Campo próprio, e não derivado de `criadoEm`: o fechamento é por dia de
  /// expediente, e agrupar por timestamp obriga toda consulta a repetir a
  /// conversão de fuso — que é onde nasce o lançamento das 23h caindo no dia
  /// seguinte.
  dia      String
  criadoEm DateTime @default(now())

  /// "abertura" | "sangria" | "suprimento"
  ///
  /// O valor é sempre POSITIVO e o tipo diz a direção. Guardar sangria como
  /// negativo pareceria elegante e faria a soma esconder o que aconteceu: dois
  /// lançamentos que se anulam somem, e some com eles a pergunta de por que
  /// houve dois.
  tipo     String
  valor    Float
  operador String
  operadorId String @db.ObjectId
  observacao String?

  /// Lançamento errado é CANCELADO, nunca apagado.
  ///
  /// Apagar de verdade abria o caminho mais curto para sumir com dinheiro:
  /// lançar a sangria, imprimir o comprovante para justificar a saída com
  /// alguém, e depois apagar o registro — o papel existia, o sistema não sabia
  /// de nada. Cancelado fica na lista, riscado, com quem cancelou.
  canceladoEm  DateTime?
  canceladoPor String?

  /// Quem liberou, quando o valor exigiu gerente. Fica no comprovante impresso:
  /// é o nome que a segunda pessoa assina embaixo.
  autorizadaPor String?

  @@index([loja, dia])
  @@map("movimentos_caixa")
}

/// A conferência da gaveta no fim do dia.
///
/// Guarda o RETRATO do que o sistema calculou, e não só a diferença: se uma
/// venda daquele dia for cancelada semana que vem, o fechamento assinado
/// continua dizendo o que foi conferido na hora. Documento que muda depois de
/// assinado não serve para conferir nada.
model FechamentoCaixa {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  loja String
  dia  String

  fechadoEm    DateTime @default(now())
  fechadoPor   String
  fechadoPorId String   @db.ObjectId

  /// A conta do dinheiro em espécie, parcela por parcela — para o papel poder
  /// mostrar COMO se chegou ao esperado, em vez de só afirmar o total.
  abertura     Float
  vendasDinheiro Float
  sangrias     Float
  suprimentos  Float
  esperado     Float
  /// O que a pessoa contou na gaveta. É o único número que o sistema não sabe.
  contado      Float
  /// contado − esperado. Positivo sobrou, negativo faltou.
  diferenca    Float

  /// As outras formas não entram na conferência da gaveta (o dinheiro delas vai
  /// para o banco), mas entram no papel: é o movimento do dia.
  vendasPix     Float @default(0)
  vendasDebito  Float @default(0)
  vendasCredito Float @default(0)
  vendasPrazo   Float @default(0)
  totalVendido  Float @default(0)
  quantidadeVendas Int @default(0)
  canceladas       Int @default(0)

  observacao String?

  /// Reaberto: o fechamento deixou de valer e o dia aceita lançamento de novo.
  ///
  /// Antes, reabrir APAGAVA o fechamento. Dava para fechar, ver que faltavam
  /// R$ 300, reabrir, lançar uma sangria que explicasse a falta e fechar com a
  /// gaveta batendo — sem vestígio da primeira contagem. Agora o documento fica,
  /// marcado, e as contagens anteriores ficam guardadas em `tentativas`.
  reabertoEm  DateTime?
  reabertoPor String?

  /// Cada contagem que foi desfeita por uma reabertura, na ordem em que
  /// aconteceram. É o que permite ver "este caixa foi fechado três vezes até
  /// bater" — a informação que a reabertura silenciosa escondia.
  tentativas ContagemDesfeita[]

  /// Um por loja por dia. É o índice que impede dois fechamentos do mesmo
  /// expediente — e não uma checagem na tela, que duas abas contornam. Serve
  /// também de índice de consulta: não precisa de um `@@index` igual ao lado.
  @@unique([loja, dia])
  @@map("fechamentos_caixa")
}

/// Cada vez que o preço de um produto muda.
///
/// O catálogo guarda só o preço de agora, e sobrescrever apagava a pergunta:
/// dava para baixar o preço, fazer a venda e devolver ao normal sem deixar
/// vestígio. A venda guarda o preço praticado, então era possível VER que saiu
/// barata — mas não que alguém mexeu no cadastro naquele minuto.
///
/// Livro, como o de estoque: só cresce, nunca é reescrito.
model AlteracaoDePreco {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  produtoId String   @db.ObjectId
  criadoEm  DateTime @default(now())

  /// De quanto para quanto. Guardar os dois evita ter de reconstruir a série
  /// inteira para saber o que aconteceu numa linha só.
  de   Float
  para Float

  operador   String
  operadorId String @db.ObjectId

  @@index([produtoId, criadoEm])
  @@index([criadoEm])
  @@map("alteracoes_preco")
}

/// A política de compra de um produto, calculada a partir do histórico de venda.
///
/// Fica separada do `Produto` porque é DERIVADA: some e volta a cada recálculo,
/// enquanto código, descrição e preço são cadastro que alguém digitou. Misturar
/// as duas coisas faria uma rotina de importação passar por cima de dado humano.
///
/// Os números são da REDE somada, não de cada loja: a compra é central (a matriz
/// compra e distribui, e é isso que as transferências no histórico mostram).
model PoliticaDeCompra {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  produtoId String @unique @db.ObjectId

  /// Quanto sai por dia, em média, na rede toda. É a base de todo o resto.
  consumoMedioDiario Float

  /// Abaixo disto o produto está em risco: é o que cobre o atraso do fornecedor
  /// e a semana em que a venda vem acima da média.
  estoqueMinimo Float

  /// Quando o saldo cruza para baixo daqui, é hora de comprar — o que resta
  /// cobre só o tempo até a mercadoria nova chegar.
  pontoDePedido Float

  /// Quanto comprar quando chega a hora, antes de descontar o que já existe.
  loteDeCompra Float

  /// De onde saíram os números, para ninguém confiar num cálculo velho sem saber.
  calculadoEm   DateTime @default(now())
  diasAnalisados Int
  /// Em quantos dias distintos houve venda. Um produto vendido em 2 dias de 365
  /// tem média baixa e comportamento errático — a média sozinha não conta isso.
  diasComVenda  Int
  /// Total vendido no período analisado, para conferir a conta de fora.
  vendidoNoPeriodo Float

  @@map("politicas_de_compra")
}

/// De quem se compra.
///
/// A chave é o `codigo` do sistema antigo, e não o documento. Parece natural
/// usar CNPJ — é o que identifica a empresa no mundo — mas o cadastro real não
/// coopera: onze fornecedores foram cadastrados com o placeholder
/// `000.000.000-00`, e um mesmo CNPJ aparece em dois códigos diferentes (um
/// cadastro antigo e o atual da mesma empresa). Um índice único no documento
/// recusaria a importação de doze cadastros legítimos.
model Fornecedor {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  codigo String @unique

  razaoSocial String
  /// Metade dos cadastros não tem: a tela cai na razão social quando falta.
  nomeFantasia String?

  cidade String
  bairro String

  /// Só os dígitos, e ausente quando o cadastro veio com placeholder. Guardar
  /// `00000000000` seria guardar uma mentira que parece um documento — e um dia
  /// alguém emitiria algo com ela.
  documento  String?
  /// "FISICA" | "JURIDICA", derivado do documento. Nulo quando não há documento.
  tipoPessoa String?

  /// A data da última compra, do sistema antigo. É o que separa fornecedor vivo
  /// de cadastro dormente: 69 dos 128 nunca compraram nada.
  ultimaCompra DateTime?

  /// Fornecedor não é apagado — assim como produto e cliente. Quando houver
  /// compra registrada, apagar deixaria a compra órfã.
  ativo      Boolean @default(true)
  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("fornecedores")
}

/// Quem já forneceu um produto, por quanto e quando.
///
/// Derivado do histórico de compra, como a política: some e volta a cada
/// importação. Um produto pode ter vários fornecedores — 117 têm — e é por isso
/// que isto é uma tabela e não um campo `fornecedorId` no `Produto`. Um campo só
/// obrigaria a escolher um e jogar fora a alternativa, que é exatamente a
/// informação que serve na hora de negociar preço.
model Fornecimento {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  produtoId    String @db.ObjectId
  fornecedorId String @db.ObjectId

  /// O custo unitário da compra mais recente deste produto neste fornecedor.
  /// É o que a tela de compras usa para estimar o desembolso — preço de venda
  /// superestima, e um custo médio de dois anos ignora o reajuste do ano.
  ultimoCusto  Float
  ultimaCompra DateTime

  /// O acumulado, que mede a relevância: um fornecedor que entregou o produto
  /// trinta vezes é o de sempre; o que entregou uma foi quebra-galho.
  quantidadeTotal Float
  compras         Int

  /// O de sempre para este produto: quem forneceu por último. Exatamente um por
  /// produto. É ele que entra no pedido quando ninguém escolhe outro.
  principal Boolean @default(false)

  @@unique([produtoId, fornecedorId])
  @@index([fornecedorId])
  @@index([produtoId, principal])
  @@map("fornecimentos")
}

/// Um pedido de compra: o que se pediu, a quem, por quanto.
///
/// Nasce da tela de compras e vira papel. A situação existe porque um pedido
/// tem vida: é montado, é mandado ao fornecedor, e um dia a mercadoria chega —
/// e enquanto não chega, o que foi pedido conta como estoque a caminho, do
/// mesmo jeito que a transferência em trânsito.
model PedidoDeCompra {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  /// Sequência única da rede: a compra é central, e um número por loja faria o
  /// mesmo pedido ter nomes diferentes dependendo de quem olha.
  numero Int    @unique

  fornecedorId String @db.ObjectId
  /// O nome como estava no dia do pedido. Desnormalizado de propósito: o
  /// cadastro pode ser corrigido depois, e o papel já impresso não muda.
  fornecedorNome String

  /// "rascunho" | "enviado" | "recebido" | "cancelado"
  situacao String @default("rascunho")

  itens PedidoItem[]
  total Float

  criadoEm   DateTime @default(now())
  criadoPor  String
  observacao String?

  enviadoEm  DateTime?
  enviadoPor String?

  recebidoEm  DateTime?
  recebidoPor String?

  canceladoEm  DateTime?
  canceladoPor String?

  @@index([situacao, criadoEm])
  @@index([fornecedorId])
  @@map("pedidos_de_compra")
}

type PedidoItem {
  produtoId String @db.ObjectId
  codigo    String
  descricao String
  unidade   String
  quantidade Float
  /// O custo esperado no dia do pedido. O que a nota cobrar pode divergir — e é
  /// justamente por guardar o esperado que a divergência fica visível depois.
  custoUnitario Float
  total         Float
}

/// Até onde a sincronização de NF-e da SEFAZ (`distNSU`) avançou, por loja.
///
/// O NSU é o cursor de paginação do webservice de Distribuição de DF-e: cada
/// chamada devolve até 50 documentos a partir dele. Sem guardar onde parou,
/// toda sincronização recomeçaria do zero — e do zero é literalmente "desde
/// que o CNPJ existe para a SEFAZ", não "desde a última vez que rodamos isto".
model SincronizacaoSefaz {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  loja String @unique

  /// Sempre 15 dígitos, com zeros à esquerda — é o formato que a SEFAZ pede de
  /// volta em `ultNSU`. Guardado como veio, para não reintroduzir um bug de
  /// padding numa conversão de ida e volta.
  ultNsu String
  /// O que a SEFAZ tinha disponível na última consulta — só para a tela dizer
  /// "sincronizado" ou "ainda falta X documentos", não é usado para nada além disso.
  maxNsu String

  atualizadoEm DateTime @updatedAt

  @@map("sincronizacoes_sefaz")
}

/// Uma NF-e de fornecedor, indexada localmente a partir da sincronização com a
/// SEFAZ — não é a entrada de estoque em si (isso é fase 3), é o catálogo do
/// que está disponível para escolher.
///
/// O XML completo (com itens) só vem preenchido quando a própria sincronização
/// já trouxe um `procNFe` — a maioria das notas recentes vem assim, de graça,
/// sem chamada extra. Nota mais antiga que a SEFAZ já podou da distribuição
/// chega como resumo (`resNFe`): sem itens, e sem uma segunda chamada que
/// resolva isso, porque o documento completo já não está mais lá para buscar.
model NotaFiscalRecebida {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  /// Código da loja/CNPJ destinatário — QI, QNE, NRT, SDS.
  loja        String
  chaveAcesso String @unique
  /// O NSU sob o qual a SEFAZ devolveu este documento — não é usado para nada
  /// depois de gravado; fica só para auditoria de quando isto chegou.
  nsu         String

  emitenteCnpj String
  emitenteNome String
  numero       Int?
  serie        Int?
  dataEmissao  DateTime?
  valorTotal   Float?

  /// "resumo" | "completa" — se `xml` tem os itens ou só os dados de cabeçalho.
  situacaoXml String
  /// Só preenchido quando `situacaoXml` é "completa". Guardado para não ter
  /// que buscar de novo na SEFAZ toda vez que o gerente abrir a nota.
  xml String?

  /// "disponivel" | "recebida" | "ignorada"
  situacao String @default("disponivel")

  criadoEm DateTime @default(now())

  @@index([loja, situacao, criadoEm])
  @@map("notas_fiscais_recebidas")
}
